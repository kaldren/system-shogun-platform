#!/bin/sh
# Blocks `git push` if gitleaks is missing or finds a secret in the commits being pushed.
# Installed via: git config core.hooksPath .githooks   (see README.md "Development setup")
# This is a fail-closed local check; the GitHub Actions secret-scan workflow and
# GitHub push protection are the server-side backstops that still apply even if
# this hook is skipped with --no-verify or never installed on a given machine.

set -e

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "----------------------------------------------------------------------"
  echo "ERROR: gitleaks is not installed — push blocked."
  echo ""
  echo "Install it, then try again:"
  echo "  Windows (winget): winget install Gitleaks.Gitleaks"
  echo "  Windows (scoop):  scoop install gitleaks"
  echo "  macOS (brew):     brew install gitleaks"
  echo "  Or download a release binary: https://github.com/gitleaks/gitleaks/releases"
  echo "----------------------------------------------------------------------"
  exit 1
fi

zero_sha="0000000000000000000000000000000000000000"
found_secrets=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero_sha" ] && continue # deleting a ref, nothing to scan

  if [ "$remote_sha" = "$zero_sha" ]; then
    # New branch on the remote: scan the full history of what's being pushed.
    range="$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi

  echo "Scanning $range for secrets before push to $remote_ref ..."
  if ! gitleaks detect --no-banner --redact --log-opts="$range"; then
    found_secrets=1
  fi
done

if [ "$found_secrets" -ne 0 ]; then
  echo "----------------------------------------------------------------------"
  echo "ERROR: gitleaks found potential secrets in the commits being pushed."
  echo "Push blocked. Remove the secret (and rewrite history if it was already"
  echo "committed) before pushing, or add a vetted false positive to"
  echo ".gitleaks.toml's [allowlist]."
  echo "----------------------------------------------------------------------"
  exit 1
fi

exit 0
